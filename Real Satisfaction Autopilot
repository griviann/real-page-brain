name: Real Satisfaction Autopilot V12 - REAL GREY MATTER
on:
  workflow_dispatch:
  schedule:
    - cron: '*/30 * * * *'
jobs:
  autopilot:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Setup Node V12
        uses: actions/setup-node@v4
        with:
          node-version: '20'
      - name: Run V12 Brain with Groq
        env:
          FB_PAGE_ACCESS_TOKEN: ${{ secrets.FB_PAGE_ACCESS_TOKEN }}
          FB_PAGE_ID: ${{ secrets.FB_PAGE_ID }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          FB_PAGE_TOKEN: ${{ secrets.FB_PAGE_ACCESS_TOKEN }}
        run: |
          npm install axios || true
          node commentBot.js
      - name: Save Memory Forever
        run: |
          git config --global user.name "griviann"
          git config --global user.email "griviann@users.noreply.github.com"
          git add memory.json || true
          git commit -m "V12 memory update - no more spam" || echo "No new memory"
          git push || echo "Nothing to push"
