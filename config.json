
const fs = require('fs');
console.log("🧠 Real V5 Brain Starting...");

const PAGE_ID = process.env.PAGE_ID;
const PAGE_TOKEN = process.env.PAGE_TOKEN;

console.log(`📄 PAGE_ID: ${PAGE_ID ? 'LOADED' : 'MISSING'}`);
console.log(`🔑 TOKEN: ${PAGE_TOKEN ? 'LOADED' : 'MISSING'}`);

if(!PAGE_ID || !PAGE_TOKEN){
  console.log("❌ Secrets missing! Add PAGE_ID and PAGE_TOKEN in GitHub Secrets");
  process.exit(1);
}

// Default config - won't crash even if files missing
let BRAIN = {
  posting: { emergencyStop: false },
  towns: ["Kisumu","Nakuru","Eldoret","Nairobi","Kisii","Mombasa","Kakamega","Bungoma","Kapenguria"],
  phone: "0758825414"
};

try {
  if(fs.existsSync('./config.json')){
    const c = fs.readFileSync('./config.json','utf8');
    if(c.trim().length > 2) BRAIN = JSON.parse(c);
  }
  if(fs.existsSync('./brain.json')){
    const c = fs.readFileSync('./brain.json','utf8');
    if(c.trim().length > 2) BRAIN = JSON.parse(c);
  }
} catch(e){ console.log("⚠️ Using default brain, config empty"); }

console.log(`🧠 Brain ${BRAIN.version || 'V5'} loaded`);
console.log(`Towns: ${BRAIN.towns?.join(', ')}`);

if(BRAIN.posting && BRAIN.posting.emergencyStop){
  console.log('🛑 STOP flag true - not posting'); 
  process.exit(0);
}

// --- CREATE POST ---
const towns = BRAIN.towns || ["Kapenguria","Kitale","Eldoret","Nakuru"];
const town = towns[Math.floor(Math.random()*towns.length)];
const phone = BRAIN.phone || "0758825414";

const posts = [
`🔥 REAL SATISFACTION - ${town} 🔥

Need a companion tonight in ${town}?

✅ Discreet & Private
✅ Available Now in ${town}
✅ 100% Real Photos
✅ Call/WhatsApp: ${phone}

DM us now or call! We are online in ${town} today!

#${town} #RealSatisfaction #Kenya`,

`💋 Hello ${town} 💋
Beautiful, clean, respectful ladies available NOW!

📍 Location: ${town} Town
⏰ Available: Day & Night
📞 ${phone}

Don't be lonely tonight - Chat with us!
Inbox is OPEN 🔓

#${town}Ladies #Nairobi #Kisumu`,

`✨ ${town} LADIES ✨

Looking for real company in ${town}?

We got you:
🌹 Hot & Classy
🌹 Affordable
🌹 24/7 in ${town}
🌹 Call: ${phone}

We come to you or you come to us - Your choice!

Message now 👇

#${town}`
];

const message = posts[Math.floor(Math.random()*posts.length)];

async function postToFacebook(){
  const url = `https://graph.facebook.com/v19.0/${PAGE_ID}/feed`;
  const params = new URLSearchParams();
  params.append('message', message);
  params.append('access_token', PAGE_TOKEN);
  
  console.log(`📤 Posting to ${town}: ${message.substring(0,50)}...`);
  
  const res = await fetch(url, { method: 'POST', body: params });
  const data = await res.json();
  
  console.log("FB Response:", JSON.stringify(data));
  
  if(data.id){
    console.log(`✅ SUCCESS! Posted ID: ${data.id}`);
  } else {
    console.log(`❌ FB Error: ${data.error?.message}`);
    throw new Error(data.error?.message || 'Post failed');
  }
}

postToFacebook();
